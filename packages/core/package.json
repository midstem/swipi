{
  "name": "@midstem/swipi",
  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "author": "Midstem",
  "description": "Headless TypeScript carousel engine for vanilla JavaScript",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midstem/swipi.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "carousel",
    "slider",
    "vanilla",
    "javascript",
    "typescript",
    "headless",
    "infinite-carousel",
    "image-carousel"
  ],
  "bugs": {
    "url": "https://github.com/midstem/swipi/issues"
  },
  "homepage": "https://swipi.midstem.net/",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "tsc -p scripts/types-fixture",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "size": "node ../../tools/scripts/report-size.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "prepack": "node ../../tools/scripts/copy-root-docs.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
