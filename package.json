{
  "name": "swipi-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Midstem",
  "description": "Monorepo for the Swipi carousel: a framework-agnostic core and the adapters built on it",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midstem/swipi.git"
  },
  "bugs": {
    "url": "https://github.com/midstem/swipi/issues"
  },
  "homepage": "https://swipi.midstem.net/",
  "scripts": {
    "start": "npm run start --workspace @swipi/playground-react",
    "start:vue": "npm run start --workspace @swipi/playground-vue",
    "start:svelte": "npm run start --workspace @swipi/playground-svelte",
    "build": "npm run build --workspace @swipi/core --workspace @swipi/playground-core --workspace @midstem/swipi-react --workspace @midstem/swipi-vue --workspace @midstem/swipi-svelte --workspace @midstem/swipi-angular",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:package": "npm run typecheck:package --workspace @midstem/swipi-react --workspace @midstem/swipi-vue --workspace @midstem/swipi-svelte --workspace @midstem/swipi-angular",
    "verify:package": "npm run verify:package --workspace @midstem/swipi-react --workspace @midstem/swipi-vue --workspace @midstem/swipi-svelte --workspace @midstem/swipi-angular",
    "verify:published": "npm run verify:published --workspace @midstem/swipi-react --workspace @midstem/swipi-vue --workspace @midstem/swipi-svelte --workspace @midstem/swipi-angular",
    "size": "npm run size --workspace @midstem/swipi-react --workspace @midstem/swipi-vue --workspace @midstem/swipi-svelte --workspace @midstem/swipi-angular",
    "test": "vitest",
    "test:run": "npm run test:run --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint --cache ./packages ./apps --quiet --fix",
    "lint:format": "prettier --write --log-level warn \"./**/*.{js,jsx,mjs,ts,tsx,svelte,css,md,json}\"",
    "lint-tsc": "npm run build --workspace @swipi/core && npm run lint:format && npm run lint:fix && npm run typecheck",
    "release": "node tools/release/index.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "^7.58.12",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/svelte": "^5.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.0.0",
    "jsdom": "^30.0.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "react": ">=19",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1"
  },
  "pre-commit": "lint-tsc"
}
