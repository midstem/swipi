{
  "name": "swipi-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Maksym Tkachuk, Oleksandr Didyshen",
  "description": "Monorepo for the Swipi carousel: a framework-agnostic core and the adapters built on it",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midstem/swipi.git"
  },
  "bugs": {
    "url": "https://github.com/midstem/swipi/issues"
  },
  "homepage": "https://midstem.github.io/swipi-landing/",
  "scripts": {
    "start": "npm run start --workspace @swipi/playground",
    "build": "npm run build --workspace @swipi/core --workspace swipi",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:package": "npm run typecheck:package --workspace swipi",
    "verify:package": "npm run verify:package --workspace swipi",
    "verify:published": "npm run verify:published --workspace swipi",
    "size": "npm run size --workspace swipi",
    "test": "vitest",
    "test:run": "npm run test:run --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint --cache ./packages ./apps --quiet --fix",
    "lint:format": "prettier --write --log-level warn \"./**/*.{js,jsx,mjs,ts,tsx,css,md,json}\"",
    "lint-tsc": "npm run build && npm run verify:package && npm run lint:format && npm run lint:fix && npm run typecheck && npm run test:run"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "^7.58.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^30.0.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.8.4",
    "react": ">=19",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  },
  "pre-commit": "lint-tsc"
}
