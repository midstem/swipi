{
  "name": "swipi",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Maksym Tkachuk, Oleksandr Didyshen",
  "description": "Headless TypeScript carousel hook for React",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midstem/swipi.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "react",
    "typescript",
    "headless",
    "carousel",
    "react-hook",
    "infinite-carousel",
    "image-carousel"
  ],
  "bugs": {
    "url": "https://github.com/midstem/swipi/issues"
  },
  "homepage": "https://midstem.github.io/swipi-landing/",
  "scripts": {
    "start": "vite --open --host",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "tsc -p scripts/types-fixture",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "size": "node scripts/report-size.mjs",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --cache ./src --quiet --fix",
    "lint:format": "prettier --write --log-level warn \"./**/*.{js,jsx,mjs,ts,tsx,css,md,json}\"",
    "test:run": "vitest run",
    "lint-tsc": "npm run build && npm run verify:package && npm run lint:format && npm run lint:fix && npm run typecheck && npm run test:run"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^30.0.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.8.4",
    "react": ">=19",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  },
  "pre-commit": "lint-tsc"
}
